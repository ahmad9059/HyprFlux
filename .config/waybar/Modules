{
  "temperature": {
    "interval": 10,
    "hwmon-path-abs": [
      "/sys/devices/platform/coretemp.0/hwmon",
      "/sys/devices/pci0000:00/0000:00:18.3/hwmon"
    ],
    "input-filename": "temp1_input",
    "warning-threshold": 80,
    "critical-threshold": 90,
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["󰈸"],
    "tooltip-format": "CPU temperature: {temperatureC}°C\nRight click: GPU monitor",
    "on-click-right": "$HOME/.config/hypr/scripts/WaybarScripts.sh --nvtop"
  },
  "backlight": {
    "format": "{icon}",
    "format-icons": [" ", " ", " ", "󰃝 ", "󰃞 ", "󰃟 ", "󰃠 "],
    "tooltip-format": "Brightness: {percent}%\nScroll: adjust brightness",
    "on-scroll-up": "$HOME/.config/hypr/scripts/Brightness.sh --inc",
    "on-scroll-down": "$HOME/.config/hypr/scripts/Brightness.sh --dec",
    "smooth-scrolling-threshold": 1
  },
  "backlight#2": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"]
  },
  "battery": {
    "interval": 30,
    "states": {"warning": 30, "critical": 15},
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": "󱘖 {capacity}%",
    "format-full": "{icon} Full",
    "format-alt": "{icon} {time}",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "format-time": "{H}h {M}min",
    "tooltip-format": "{capacity}% · {timeTo}\nPower: {power:.1f} W\nRight click: power menu",
    "on-click-right": "$HOME/.config/hypr/scripts/Wlogout.sh"
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂳",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "Bluetooth: {status}\nClick: Bluetooth settings",
    "tooltip-format-connected": "{device_enumerate}\nClick: Bluetooth settings",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "blueman-manager"
  },
  "clock": {
    "interval": 60,
    "format": " {:%I:%M %p}",
    "format-alt": " {:%H:%M   %Y, %d %B, %A}",
    "tooltip-format": "<b>{:%A, %d %B %Y}</b>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{:%V}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    "actions": {"on-scroll-up": "shift_up", "on-scroll-down": "shift_down"}
  },
  "clock#2": {
    "format": " {:%H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },
  "clock#3": {"format": "{:%H:%M - %d/%b}", "tooltip": false},
  "clock#4": {"format": "{:%B | %a %d, %Y | %H:%M}"},
  "clock#5": {"format": "{:%a %d | %H:%M}"},
  "cpu": {
    "interval": 5,
    "format": "{usage}% 󰍛",
    "tooltip": true,
    "on-click-right": "$HOME/.config/hypr/scripts/WaybarScripts.sh --btop"
  },
  "disk": {
    "interval": 60,
    "paths": ["/"],
    "format": "{percentage_used}% 󰋊",
    "tooltip-format": "{path}: {used} / {total} ({percentage_used}%)"
  },
  "hyprland/language": {
    "format": " {short}",
    "on-click": "hyprctl switchxkblayout all next",
    "tooltip-format": "Keyboard: {long}\nClick: next layout"
  },
  "hyprland/submap": {"format": "<i> {}</i>", "tooltip": false},
  "hyprland/window": {
    "format": "{}",
    "max-length": 24,
    "separate-outputs": true,
    "rewrite": {"(.*) — Mozilla Firefox": " $1"}
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {"activated": "", "deactivated": ""},
    "tooltip-format-activated": "Keep awake: on\nClick to allow automatic idle locking and screen blanking",
    "tooltip-format-deactivated": "Keep awake: off\nClick to inhibit automatic idle actions"
  },
  "keyboard-state": {
    "capslock": true,
    "format": {"capslock": "󰪛 {icon}"},
    "format-icons": {"locked": "", "unlocked": ""}
  },
  "memory": {
    "interval": 10,
    "format": "{used:.1f}G 󰾆",
    "format-alt": "{percentage}% 󰾆",
    "tooltip-format": "Memory: {used:.1f} / {total:.1f} GiB\nRight click: system monitor",
    "on-click-right": "$HOME/.config/hypr/scripts/WaybarScripts.sh --btop"
  },
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "󰏤 {dynamic}",
    "dynamic-order": ["title", "artist"],
    "dynamic-len": 26,
    "title-len": 26,
    "artist-len": 12,
    "max-length": 28,
    "tooltip-format": "{player}: {title}\n{artist}\nLeft: play/pause · Middle: previous · Right: next",
    "player-icons": {"default": "", "spotify": "", "firefox": "", "chromium": "", "mpv": "󰐹", "vlc": "󰕼"}
  },
  "network": {
    "interval": 5,
    "format-wifi": "{icon}",
    "format-ethernet": "󰌘",
    "format-disconnected": "󰌙",
    "format-linked": "󰈁",
    "tooltip-format-wifi": "{essid} · {signalStrength}%\n{ifname}: {ipaddr}\n↑ {bandwidthUpBits} ↓ {bandwidthDownBits}\nClick: network settings",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}\n↑ {bandwidthUpBits} ↓ {bandwidthDownBits}\nClick: network settings",
    "tooltip-format-disconnected": "Network disconnected\nClick: network settings",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "on-click": "$HOME/.config/hypr/scripts/WaybarScripts.sh --nmtui",
    "on-click-right": "$HOME/.config/hypr/scripts/WaybarScripts.sh --nmtui"
  },
  "network#speed": {
    "interval": 2,
    "format-wifi": "{icon} ↑ {bandwidthUpBytes} ↓ {bandwidthDownBytes}",
    "format-ethernet": "󰌘 ↑ {bandwidthUpBytes} ↓ {bandwidthDownBytes}",
    "format-disconnected": "󰌙",
    "tooltip-format": "{ifname}: {ipaddr}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "on-click": "$HOME/.config/hypr/scripts/WaybarScripts.sh --nmtui"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}\nClick: cycle profile",
    "format-icons": {"default": "", "performance": "", "balanced": "", "power-saver": ""}
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon}  {volume}%",
    "format-muted": "󰖁",
    "format-bluetooth-muted": "󰖁 ",
    "format-icons": {"headphone": "", "headset": "", "default": ["", "", "󰕾"]},
    "ignored-sinks": ["Easy Effects Sink"],
    "on-click": "$HOME/.config/hypr/scripts/Volume.sh --toggle",
    "on-click-right": "pavucontrol -t 3",
    "on-scroll-up": "$HOME/.config/hypr/scripts/Volume.sh --inc",
    "on-scroll-down": "$HOME/.config/hypr/scripts/Volume.sh --dec",
    "tooltip-format": "{desc}: {volume}%\nClick: mute · Right: mixer · Scroll: volume",
    "smooth-scrolling-threshold": 1
  },
  "pulseaudio#1": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁",
    "format-icons": {"default": ["", "", "󰕾"]},
    "on-click": "$HOME/.config/hypr/scripts/Volume.sh --toggle",
    "on-click-right": "pavucontrol -t 3"
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": " {volume}%",
    "format-source-muted": "",
    "on-click": "$HOME/.config/hypr/scripts/Volume.sh --toggle-mic",
    "on-click-right": "pavucontrol -t 4",
    "on-scroll-up": "$HOME/.config/hypr/scripts/Volume.sh --mic-inc",
    "on-scroll-down": "$HOME/.config/hypr/scripts/Volume.sh --mic-dec",
    "tooltip-format": "{source_desc}: {source_volume}%\nClick: mute mic · Right: input mixer"
  },
  "tray": {"icon-size": 20, "spacing": 4},
  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁",
    "format-icons": ["", "", "󰕾"],
    "on-click": "$HOME/.config/hypr/scripts/Volume.sh --toggle",
    "on-click-right": "pavucontrol -t 3",
    "on-scroll-up": "$HOME/.config/hypr/scripts/Volume.sh --inc",
    "on-scroll-down": "$HOME/.config/hypr/scripts/Volume.sh --dec"
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 16,
    "all-outputs": false,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": ["rofi", "kitty-dropterm"]
  }
}
