{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "control-center-exclusive-zone": true,
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 10,
  "control-center-margin-bottom": 12,
  "control-center-margin-right": 12,
  "control-center-margin-left": 12,
  "control-center-width": 378,
  "control-center-height": 1100,
  "fit-to-screen": false,
  "notification-window-width": 400,
  "notification-window-height": -1,
  "notification-body-image-height": 200,
  "notification-body-image-width": 340,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "notification-grouping": true,
  "relative-timestamps": true,
  "timeout": 8,
  "timeout-low": 4,
  "timeout-critical": 0,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 180,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "All caught up",
  "script-fail-notify": true,
  "widgets": [
    "title",
    "dnd",
    "buttons-grid",
    "volume",
    "mpris",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear all"
    },
    "dnd": {
      "text": "Do not disturb"
    },
    "notifications": {
      "vexpand": true
    },
    "mpris": {
      "show-album-art": "when-available",
      "autohide": true,
      "loop-carousel": false
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true,
      "show-per-app-icon": true,
      "show-per-app-label": true,
      "expand-per-app": false,
      "expand-button-label": "Apps",
      "collapse-button-label": "Less",
      "empty-list-label": "No apps playing audio"
    },
    "buttons-grid": {
      "buttons-per-row": 3,
      "actions": [
        {
          "label": "󰌾  Lock",
          "command": "bash \"$HOME/.config/swaync/actions.sh\" lock"
        },
        {
          "label": "󰐥  Power",
          "command": "bash \"$HOME/.config/swaync/actions.sh\" power"
        },
        {
          "label": "󰒓  Settings",
          "command": "bash \"$HOME/.config/swaync/actions.sh\" settings"
        },
        {
          "label": "󰖩  Network",
          "command": "bash \"$HOME/.config/swaync/actions.sh\" network"
        },
        {
          "label": "󰝟  Mute",
          "type": "toggle",
          "active": false,
          "command": "bash \"$HOME/.config/swaync/actions.sh\" mute-output",
          "update-command": "bash \"$HOME/.config/swaync/actions.sh\" status-output"
        },
        {
          "label": "󰍭  Mic off",
          "type": "toggle",
          "active": false,
          "command": "bash \"$HOME/.config/swaync/actions.sh\" mute-input",
          "update-command": "bash \"$HOME/.config/swaync/actions.sh\" status-input"
        }
      ]
    }
  }
}
